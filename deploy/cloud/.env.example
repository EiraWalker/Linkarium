LINKARIUM_VERSION=local
LINKARIUM_REVISION=unknown
# Dedicated host directory, owned by UID/GID 10001. Keep it outside release folders.
BOOKMARK_HOST_DATA=/srv/linkarium/data
BOOKMARK_PORT=8000
# Local checks through an SSH tunnel work with these defaults.
BOOKMARK_ALLOWED_HOSTS=localhost,127.0.0.1
BOOKMARK_PASSKEY_ORIGIN=http://localhost:8000
BOOKMARK_HTTPS=0
BOOKMARK_CSRF_ORIGINS=
# For public HTTPS, set both values after measuring the proxy's TCP peer address.
BOOKMARK_TRUST_PROXY=0
BOOKMARK_PROXY_PEER=
# Only needed with compose.capture.yaml; use the host launcher's actual group ID.
BOOKMARK_CAPTURE_GID=
