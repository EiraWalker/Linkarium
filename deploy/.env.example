# Public deployments put an HTTPS proxy in front of the loopback port.
BOOKMARK_PORT=8000
BOOKMARK_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact browser origin shared by every device. For public access use HTTPS.
# If BOOKMARK_PORT changes for local development, update this port too.
BOOKMARK_PASSKEY_ORIGIN=http://localhost:8000
BOOKMARK_HOST_DATA=../data
BOOKMARK_CAPTURE_GID=10001
BOOKMARK_HTTPS=0
BOOKMARK_CSRF_ORIGINS=
# For HTTPS behind one trusted proxy, set this to 1 AND fill the exact IP below.
# Waitress trusts only that TCP peer; wildcard/hostname values are rejected.
BOOKMARK_TRUST_PROXY=0
# Native host Nginx -> native loopback app often uses 127.0.0.1. Host Nginx ->
# Docker-published app may appear as a bridge gateway IP: measure it, do not guess.
BOOKMARK_PROXY_PEER=
