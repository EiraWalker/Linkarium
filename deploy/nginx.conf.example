# Requires ngx_http_auth_request_module (--with-http_auth_request_module).
# Replace domain and certificate paths; validate with nginx -t before reload.
# The backend must be reachable only by this proxy. Set BOOKMARK_TRUST_PROXY=1
# and BOOKMARK_PROXY_PEER to the proxy's actual TCP peer address as Waitress sees
# it (a Docker bridge gateway may differ from 127.0.0.1).
server {
    listen 443 ssl;
    server_name bookmarks.example.com;
    ssl_certificate /etc/letsencrypt/live/bookmarks.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bookmarks.example.com/privkey.pem;
    # Keep the default small. Only the exact authenticated upload routes below
    # can submit larger bodies; Waitress otherwise buffers before Django auth.
    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Connection "";
    # Overwrite, never append client-supplied forwarding identities.
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Port "";

    # Access-phase subrequest: GET owner status with the original session cookie,
    # no upload body. Only 2xx authorizes forwarding the main upload to Waitress;
    # 401/403 rejects it, and other statuses fail closed.
    location = /__bookmark_upload_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/api/v1/runtime/status;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_cache off;
        proxy_set_header Content-Length "";
        proxy_set_header Transfer-Encoding "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "";
        # Location-specific headers replace the inherited header set; repeat it.
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
    }

    location = /api/v1/imports/preview {
        client_max_body_size 20m;
        auth_request /__bookmark_upload_auth;
        proxy_pass http://127.0.0.1:8000;
    }

    location = /api/v1/restores/validate {
        client_max_body_size 16g;
        auth_request /__bookmark_upload_auth;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
