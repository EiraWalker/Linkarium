{
  "manifest_version": 3,
  "name": "收藏到 Linkarium",
  "version": "0.2.0",
  "description": "保存当前网页到 Linkarium，由发起设备调用自己的 AI API 分类。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://link.eirawav.me/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "cloud.js",
      "model.js",
      "executor.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "收藏到 Linkarium",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://link.eirawav.me/*"
      ],
      "js": [
        "common.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "status.html",
    "open_in_tab": true
  },
  "commands": {
    "show-status": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "查看最近收藏和分类状态"
    }
  },
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "linkarium@eirawav.me",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
